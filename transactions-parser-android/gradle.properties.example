# Project-wide Gradle settings.
# Copy this file to gradle.properties and fill in real values.
# gradle.properties is gitignored — never commit it.
#
# CI does not hand-write gradle.properties; it copies this file and substitutes the
# client ID, so these settings apply there too. Anything build-affecting belongs here
# rather than only in a local gradle.properties, or CI silently builds differently.
#
# MaxMetaspaceSize is not optional: Gradle's stock 384m is exhausted by a full
# `assembleRelease bundleRelease` (KSP plus dex merging across 15 modules), and the
# daemon dies mid-build rather than reporting anything useful about the cause.
org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=768m -Dfile.encoding=UTF-8
# org.gradle.parallel=true
kotlin.code.style=official

# Web client ID from GCP Credentials (see README §3) — required for Google Sign-In.
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
