<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher background layer.

  A near-black green rather than the app's amber: the accent is the *mark*, and an amber field with
  amber artwork on it would have no silhouette at all once a launcher applies a circular mask. The
  gradient is slight on purpose — enough to stop the tile reading as flat black next to other icons,
  not enough to compete with the mark at 48dp.

  Colours are the design system's own ink, not new ones invented for the icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF1E2E27" />
                <item android:offset="1" android:color="#FF0F1714" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
