<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher foreground: a statement page whose lines resolve into a rising trend.

  Drawn entirely as strokes rather than as filled shapes, and that is the constraint that shaped it.
  This same drawable is the `monochrome` layer for Android 13's themed icons, where the launcher
  discards every colour and tints the whole layer one flat shade. A filled page with darker markings
  on top would survive as an amber rectangle with nothing inside it. Strokes keep their silhouette,
  so the icon reads the same themed as it does in colour.

  Everything sits inside the 72dp safe zone (the central circle of the 108dp viewport); a launcher
  mask can crop anything outside it, and on a round mask this artwork would lose its corners.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The page. -->
    <path
        android:pathData="M41,28 H67 A7,7 0 0 1 74,35 V73 A7,7 0 0 1 67,80 H41 A7,7 0 0 1 34,73 V35 A7,7 0 0 1 41,28 Z"
        android:strokeColor="#FFB020"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Two ruled lines: enough to say "a statement", few enough to stay legible at 48dp. -->
    <path
        android:pathData="M43,40 H62"
        android:strokeColor="#FFB020"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M43,49 H55"
        android:strokeColor="#FFB020"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- The turn the app exists to show: the rows below the header become a shape. -->
    <path
        android:pathData="M43,71 L51,62 L58,67 L66,56"
        android:strokeColor="#FFB020"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
</vector>
